<script>

const OK="https://automation.espxtecnologia.com.br/webhook/novo";
const TOTAL=5;let cur=0;
const D={};
const free=["gmail.","hotmail.","outlook.","yahoo.","live.","icloud.","bol.com","uol.com.br","terra.com.br","msn."];

function prog(){const p=Math.round((cur/TOTAL)*100);document.getElementById('pbar').style.width=p+'%';document.getElementById('ppct').textContent=p+'%';}
function go(i){document.querySelectorAll('.step').forEach(s=>s.classList.remove('active'));document.querySelector('.step[data-idx="'+i+'"]').classList.add('active');cur=i;prog();}
function showErr(t){const e=document.getElementById('errMsg');e.textContent=t;e.style.display='block';setTimeout(()=>e.style.display='none',3500);}

function checkEmail(){
  const v=document.getElementById('email').value.trim().toLowerCase();
  const isFree=free.some(f=>v.includes("@")&&v.split("@")[1] && v.split("@")[1].startsWith(f));
  document.getElementById('emailConfirm').classList.toggle('show', isFree && v.includes("@"));
}

function validEmail(v){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);}
function isFreeEmail(v){const d=v.split("@")[1]||"";return free.some(f=>d.startsWith(f));}

function next(i){
  if(i===0){D.nome=document.getElementById('nome').value.trim();if(D.nome.split(" ").filter(Boolean).length<2){showErr("Informe nome e sobrenome.");return;}go(1);}
  else if(i===1){D.empresa=document.getElementById('empresa').value.trim();if(D.empresa.length<2){showErr("Informe o nome da empresa.");return;}go(2);}
  else if(i===2){D.cargo=document.getElementById('cargo').value;D.cargo_detalhe=document.getElementById('cargo_detalhe').value.trim();if(!D.cargo){showErr("Selecione o seu papel.");return;}go(3);}
  else if(i===3){D.telefone=document.getElementById('telefone').value.trim();const digits=D.telefone.replace(/\D/g,'');if(digits.length < 10 || digits.length > 11){showErr("Informe um WhatsApp válido com DDD.");return;}go(4);}
  else if(i===4){
    D.email=document.getElementById('email').value.trim();
    if(!validEmail(D.email)){showErr("Informe um e-mail válido.");return;}
    if(isFreeEmail(D.email) && !document.getElementById('emailPessoalOk').checked){showErr("Confirme que representa uma empresa real.");return;}
    if(!document.getElementById('consent').checked){showErr("Autorize o contato para continuar.");return;}
    submitLead();
  }
}

async function submitLead(){
  if(document.getElementById('website').value.trim()!==""){return;}
  const btn=document.getElementById('finalBtn');btn.disabled=true;btn.textContent="Enviando...";
  const payload={
    subject:"Novo lead Pré Raio-X (LP1) - "+D.empresa,
    from_name:"ESPX - LP1 Captura",
    origem:"LP1_captura",
    nome:D.nome,
    empresa:D.empresa,
    cargo:D.cargo,
    cargo_detalhe:D.cargo_detalhe||"",
    telefone:D.telefone,
    email:D.email,
    email_pessoal_confirmado:isFreeEmail(D.email),
    consentimento_whatsapp:"sim",
    consentimento_data:new Date().toISOString(),
    pagina:location.href,
    website:document.getElementById('website').value.trim()
  };
  try{
    const r=await fetch(OK,{
      method:"POST",
      credentials:"omit",
      headers:{
        "Content-Type":"application/json",
        Accept:"application/json",
        "x-nada":"ESPX_2026_f8K29xP4mQ7zL@"
      },
      body:JSON.stringify(payload)
    });
    if(!r.ok) throw new Error();
    const data=await r.json();
    if(!data.success)throw new Error();
    document.getElementById('formView').style.display='none';
    document.getElementById('successView').style.display='block';
  }catch(e){showErr("Não foi possível concluir o envio agora. Fale com a ESPX pelo WhatsApp.");btn.disabled=false;btn.textContent="Receber meu Pré Raio-X";}
}
prog();
</script>
